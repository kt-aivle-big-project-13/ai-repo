# 객체 스토리지 (S3 / 로컬 MinIO)
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# LLM (OpenAI 호환) — 보고서 생성 등 모든 LLM 호출이 이 설정으로 통일된다.
# OPENAI_MODEL 은 통일 대상 모델 ID 로 지정한다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com/v1

# 동시 실행 제한 — 워커 1개짜리 단일 프로세스라 요청이 겹치는 만큼 메모리·CPU 를
# 나눠 쓴다. 아래는 vCPU 2개 인스턴스 기준 기본값이라 값을 비워두면 그대로 쓴다.
# ANALYSIS_CONCURRENCY=2
# REPORT_CONCURRENCY=1
# CONCURRENCY_ACQUIRE_TIMEOUT=300
# XGBOOST_THREADS=2
